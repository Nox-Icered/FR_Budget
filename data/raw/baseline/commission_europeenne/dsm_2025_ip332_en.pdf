         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Debt Sustainability Monitor 2025</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>European Commission Economic and Financial Affairs European Economy Institutional Paper</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The Debt Sustainability Monitor 2025 provides an overview of fiscal sustainability challenges faced by EU Member States over the short, medium and long term. It also discusses the role of the debt sustainability analysis (DSA) methodology in the EU fiscal framework.</rdf:li>
            </rdf:Alt>
         </dc:description>
